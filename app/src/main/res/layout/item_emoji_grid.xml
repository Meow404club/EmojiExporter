<?xml version="1.0" encoding="utf-8"?>
<!-- 表情网格单项：方形缩略图，点击放大预览 -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardCornerRadius="8dp" app:cardElevation="0dp" app:strokeWidth="0dp"
    android:layout_margin="4dp" android:foreground="?attr/selectableItemBackground">

    <ImageView android:id="@+id/ivEmoji"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:adjustViewBounds="true" android:scaleType="fitCenter"
        android:src="@drawable/ic_emoji_placeholder"
        android:contentDescription="@string/app_name" />
</com.google.android.material.card.MaterialCardView>
